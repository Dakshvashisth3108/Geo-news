# Public env vars must be prefixed NEXT_PUBLIC_ to reach the browser.

# FastAPI backend base URL (no trailing slash). The API client appends /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: WebSocket URL override. If unset, the client derives ws[s]://
# from NEXT_PUBLIC_API_URL automatically.
NEXT_PUBLIC_WS_URL=
