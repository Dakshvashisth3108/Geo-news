# =====================================================
# GeoIntel Trade — Backend environment variables
# Copy this file to `.env` and fill in real values.
# =====================================================

# --- App ---
PROJECT_NAME="GeoIntel Trade API"
ENVIRONMENT=development        # development | staging | production
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
# Local dev (asyncpg URL):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geointel
#
# On Render.com, set ENVIRONMENT=production and paste the External Database URL
# they generate. It looks like:
#   postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require
# The app normalizes this automatically — converts `postgres://` to
# `postgresql+asyncpg://` and rewires `sslmode=require` into asyncpg's
# `connect_args["ssl"]`. No manual edits needed.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS (comma-separated list of allowed origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- External services (placeholders for later) ---
GEMINI_API_KEY=
NEWS_API_KEY=

# --- NLP service ---
# Override these only if you've fine-tuned a model or need smaller weights.
NLP_FINBERT_MODEL=ProsusAI/finbert
NLP_ZSC_MODEL=facebook/bart-large-mnli
NLP_NER_MODEL=en_core_web_sm

# --- Cache (Redis) ---
# Leave REDIS_URL blank to disable NLP result caching. Format:
#   redis://:password@host:6379/0
REDIS_URL=
NLP_CACHE_TTL_SECONDS=3600

# --- Notifications: Email (SMTP) ---
# Leave SMTP_HOST unset in dev — the email transport will log the would-be
# message instead of failing, so the rest of the alert pipeline still runs.
# Common configs:
#   Gmail App Password:  smtp.gmail.com      port 587  use_tls=true
#   SendGrid:            smtp.sendgrid.net   port 587  use_tls=true
#   Mailgun:             smtp.mailgun.org    port 587  use_tls=true
#   Localhost MailHog:   localhost           port 1025 use_tls=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@geointel.local
SMTP_USE_TLS=true

# --- Notifications: defaults ---
ALERT_DEFAULT_COOLDOWN_SECONDS=300
