# =====================================================
# GeoIntel Trade — Backend environment variables
# Copy this file to `.env` and fill in real values.
# =====================================================

# --- App ---
PROJECT_NAME="GeoIntel Trade API"
ENVIRONMENT=development        # development | staging | production
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database (async Postgres URL) ---
# Example: postgresql+asyncpg://user:password@localhost:5432/geointel
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geointel

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS (comma-separated list of allowed origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- External services (placeholders for later) ---
GEMINI_API_KEY=
NEWS_API_KEY=
